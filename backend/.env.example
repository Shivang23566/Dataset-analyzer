# ═══════════════════════════════════════════════
# DataLens Backend — Environment Variables Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Database Configuration ────────────────────
# PostgreSQL (Production):
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/datalens_db
# SQLite (Development):
# DATABASE_URL=sqlite+aiosqlite:///./datalens.db
DATABASE_URL=sqlite+aiosqlite:///./datalens.db

SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?ssl=require
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PRO_PLAN_AMOUNT_PAISE=21900
PRO_PLAN_DURATION_DAYS=30
ADMIN_SECRET_KEY=your_admin_secret

# ── Email (Gmail SMTP — required for OTP signup) ──
EMAIL_USERNAME=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_FROM_NAME=DataLens
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ── OTP Settings (optional — sensible defaults) ──
# OTP_EXPIRY_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# ── Environment ──
ENVIRONMENT=development

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
